# =============================================================
# LifeOS Backend — Environment Variables Template
# =============================================================
# CARA PAKAI:
#   1. Salin file ini: cp .env.example .env
#   2. Isi nilai yang sesuai di .env
#   3. JANGAN commit file .env ke Git!
#
# Untuk Render deployment:
#   Set semua variable ini di Render Dashboard → Environment
# =============================================================

# -----------------------------------------------
# SERVER
# -----------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production

# -----------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------
# Contoh Neon: jdbc:postgresql://ep-xxx.neon.tech/dbname?sslmode=require
# Contoh Render: jdbc:postgresql://dpg-xxx.oregon-postgres.render.com/lifeos
DATABASE_URL=jdbc:postgresql://localhost:5432/lifeos
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password-here

# -----------------------------------------------
# JWT (JSON Web Token)
# -----------------------------------------------
# WAJIB: minimal 256 bit (32 karakter). Generate dengan:
#   openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-replace-this-now
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------
# FIREBASE (FCM Push Notification)
# -----------------------------------------------
# Opsi 1: Pakai classpath (taruh serviceAccountKey.json di resources)
FIREBASE_CONFIG_PATH=classpath:serviceAccountKey.json

# Opsi 2: Pakai path absolut (untuk Docker volume mount)
# FIREBASE_CONFIG_PATH=/app/config/serviceAccountKey.json
