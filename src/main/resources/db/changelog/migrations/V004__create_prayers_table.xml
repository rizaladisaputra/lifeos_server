<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V004-create-prayers-table" author="lifeos">
        <createTable tableName="prayers">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prayers_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="time" type="VARCHAR(10)"/>
            <column name="is_completed" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_prayers_user_date" tableName="prayers">
            <column name="user_id"/>
            <column name="date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
