<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V003-create-habits-table" author="lifeos">
        <createTable tableName="habits">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_habits_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="emoji" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="V003-create-habit-logs-table" author="lifeos">
        <createTable tableName="habit_logs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="habit_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_habit_logs_habit"
                             references="habits(id)"
                             deleteCascade="true"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="habit_logs"
                columnNames="habit_id, date"
                constraintName="uq_habit_logs_habit_date"/>

        <createIndex indexName="idx_habit_logs_habit" tableName="habit_logs">
            <column name="habit_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
