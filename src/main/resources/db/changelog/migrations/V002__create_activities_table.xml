<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V002-create-activities-table" author="lifeos">
        <createTable tableName="activities">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_activities_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="time" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="emoji" type="VARCHAR(20)"/>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="is_completed" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_activities_user_date" tableName="activities">
            <column name="user_id"/>
            <column name="date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
